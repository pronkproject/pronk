# The normal extension-release check follows a distribution compatibility
# level. That is too broad for a development image which replaces Mutter
# libraries, so expose this extension only for the exact deployment and kernel
# against which it was built.

manifest=${PRONK_SYSEXT_MANIFEST:-/etc/pronk-sysext/manifest}
disabled=${PRONK_SYSEXT_DISABLED:-/etc/pronk-sysext/disabled}
os_release=${PRONK_SYSEXT_OS_RELEASE:-/usr/lib/os-release}
runtime_dir=${PRONK_SYSEXT_RUNTIME_DIR:-/run/extensions}
extension=${PRONK_SYSEXT_IMAGE:-/var/lib/pronk-sysext/pronk}
runtime_extension="$runtime_dir/pronk"

strip_quotes()
{
	value=$1
	case "$value" in
	\"*\") value=${value#\"}; value=${value%\"} ;;
	\'*) value=${value#\'}; value=${value%\'} ;;
	esac
	printf '%s\n' "$value"
}

read_value()
{
	file=$1
	key=$2

	while IFS= read -r line || test -n "$line"; do
		case "$line" in
		"$key="*)
			strip_quotes "${line#*=}"
			return 0
			;;
		esac
	done < "$file"

	return 1
}

remove_owned_link()
{
	test -L "$runtime_extension" || return 0
	test "$(readlink "$runtime_extension")" = "$extension" || return 0
	rm -f -- "$runtime_extension"
}

remove_owned_link

test ! -e "$disabled" || exit 0
test -r "$manifest" || exit 0
test -r "$os_release" || exit 0

expected_ostree=$(read_value "$manifest" HOST_OSTREE_VERSION) || exit 0
expected_kernel=$(read_value "$manifest" HOST_KERNEL_RELEASE) || exit 0
host_ostree=$(read_value "$os_release" OSTREE_VERSION) || exit 0
host_kernel=${PRONK_SYSEXT_KERNEL_RELEASE:-$(uname -r)}

test -n "$expected_ostree" || exit 0
test -n "$expected_kernel" || exit 0
test "$host_ostree" = "$expected_ostree" || exit 0
test "$host_kernel" = "$expected_kernel" || exit 0

mkdir -p -- "$runtime_dir"
# Never replace a path not created by this generator.
test ! -e "$runtime_extension" && test ! -L "$runtime_extension" || exit 0
ln -s -- "$extension" "$runtime_extension"
