#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later

set -euo pipefail

module_path="/usr/lib/modules/$(uname -r)/extra/castkms.ko"

if grep -q '^castkms ' /proc/modules; then
	echo 'CastKMS is already loaded; leaving the running module in place.'
	exit 0
fi

if [[ ! -r $module_path ]]; then
	echo "CastKMS module is missing for $(uname -r): $module_path" >&2
	exit 1
fi

declare -a dependencies=()
dependency_csv=$(modinfo -F depends "$module_path")
if [[ -n $dependency_csv ]]; then
	IFS=',' read -r -a dependencies <<< "$dependency_csv"
fi

soft_dependencies=$(modinfo -F softdep "$module_path")
for dependency in $soft_dependencies; do
	case $dependency in
	pre:|post:)
		continue
		;;
	esac
	dependencies+=("$dependency")
done

if ((${#dependencies[@]} > 0)); then
	modprobe --all "${dependencies[@]}"
fi

exec insmod "$module_path"
