#!/bin/sh
set -eu

if [ "$#" -ne 13 ] && [ "$#" -ne 14 ]; then
    echo "usage: $0 PIPEWIRE WIREPLUMBER PW_CLI TIMEOUT GST_LAUNCH PW_DUMP P2P_TEST SOCKET_ACTIVATE BACKEND PIPEWIRE_CONFIG ACCESS_CONFIG PRIVATE_POLICY_SCRIPT POLICY_MARKER_SCRIPT [TEST_ARGUMENT]" >&2
    exit 2
fi

pipewire=$1
wireplumber=$2
pw_cli=$3
timeout_program=$4
gst_launch=$5
pw_dump=$6
p2p_test=$7
socket_activate=$8
backend=$9
pipewire_config=${10}
access_config=${11}
private_policy_script=${12}
policy_marker_script=${13}
test_argument=${14-}

test_root=$(mktemp -d "${TMPDIR:-/tmp}/pronk-media-session.XXXXXX")
pipewire_pid=
wireplumber_pid=

cleanup() {
    for child in "$wireplumber_pid" "$pipewire_pid"; do
        if [ -n "$child" ] && kill -0 "$child" 2>/dev/null; then
            kill "$child" 2>/dev/null || true
        fi
    done
    for child in "$wireplumber_pid" "$pipewire_pid"; do
        if [ -n "$child" ]; then
            wait "$child" 2>/dev/null || true
        fi
    done
    rm -rf -- "$test_root"
}
trap cleanup EXIT HUP INT TERM

config_home=$test_root/config
data_home=$test_root/data
runtime_dir=$test_root/runtime
home_dir=$test_root/home
pipewire_fragments=$config_home/pipewire/pipewire.conf.d
wireplumber_fragments=$config_home/wireplumber/wireplumber.conf.d
wireplumber_scripts=$data_home/wireplumber/scripts
mkdir -p "$pipewire_fragments" "$wireplumber_fragments" \
    "$wireplumber_scripts" "$runtime_dir" "$home_dir"
chmod 0700 "$runtime_dir"
cp -- "$pipewire_config" "$pipewire_fragments/80-pronk-remotes.conf"
# Shadow an installed production fragment instead of merging the disposable
# media-gate policy with it. This keeps the isolated test independent of
# whether Pronk is already deployed on the host.
cp -- "$access_config" "$wireplumber_fragments/80-pronk-access.conf"
cp -- "$private_policy_script" "$wireplumber_scripts/pronk-private-policy.lua"
cp -- "$policy_marker_script" "$wireplumber_scripts/pronk-policy-marker.lua"

run_in_test_session() {
    XDG_CONFIG_HOME="$config_home" \
    XDG_DATA_HOME="$data_home" \
    XDG_RUNTIME_DIR="$runtime_dir" \
    PIPEWIRE_RUNTIME_DIR="$runtime_dir" \
    HOME="$home_dir" \
        "$@"
}

env XDG_CONFIG_HOME="$config_home" \
    XDG_DATA_HOME="$data_home" \
    XDG_RUNTIME_DIR="$runtime_dir" \
    PIPEWIRE_RUNTIME_DIR="$runtime_dir" \
    HOME="$home_dir" \
    "$pipewire" -c pipewire.conf \
    >"$test_root/pipewire.log" 2>&1 &
pipewire_pid=$!

manager_socket=$runtime_dir/pipewire-0-manager
for _attempt in $(seq 1 100); do
    if [ -S "$manager_socket" ]; then
        break
    fi
    if ! kill -0 "$pipewire_pid" 2>/dev/null; then
        cat "$test_root/pipewire.log" >&2
        exit 1
    fi
    sleep 0.05
done
if [ ! -S "$manager_socket" ]; then
    echo "isolated PipeWire manager endpoint was not created" >&2
    cat "$test_root/pipewire.log" >&2
    exit 1
fi

env XDG_CONFIG_HOME="$config_home" \
    XDG_DATA_HOME="$data_home" \
    XDG_RUNTIME_DIR="$runtime_dir" \
    PIPEWIRE_RUNTIME_DIR="$runtime_dir" \
    HOME="$home_dir" \
    "$wireplumber" -c wireplumber.conf -p policy \
    >"$test_root/wireplumber.log" 2>&1 &
wireplumber_pid=$!

policy_ready=false
for _attempt in $(seq 1 100); do
    if ! kill -0 "$wireplumber_pid" 2>/dev/null; then
        cat "$test_root/wireplumber.log" >&2
        exit 1
    fi
    if run_in_test_session "$timeout_program" 0.2 \
        "$pw_cli" -r pipewire-0-pronk-core info 0 >/dev/null 2>&1 && \
       run_in_test_session "$timeout_program" 0.2 \
        "$pw_cli" -r pipewire-0-pronk-backend info 0 >/dev/null 2>&1; then
        policy_ready=true
        break
    fi
    sleep 0.05
done
if [ "$policy_ready" != true ]; then
    echo "WirePlumber did not authorize both isolated media-gate roles" >&2
    cat "$test_root/wireplumber.log" >&2
    exit 1
fi

set +e
if [ -n "$test_argument" ]; then
    run_in_test_session env \
        PIPEWIRE_REMOTE=pipewire-0-pronk-core \
        PRONK_BACKEND_MEDIA_GATE=real \
        PRONK_MEDIA_GATE_GST_LAUNCH="$gst_launch" \
        PRONK_MEDIA_GATE_PW_DUMP="$pw_dump" \
        "$p2p_test" "$socket_activate" "$backend" "$test_argument"
else
    run_in_test_session env \
        PIPEWIRE_REMOTE=pipewire-0-pronk-core \
        PRONK_BACKEND_MEDIA_GATE=real \
        PRONK_MEDIA_GATE_GST_LAUNCH="$gst_launch" \
        PRONK_MEDIA_GATE_PW_DUMP="$pw_dump" \
        "$p2p_test" "$socket_activate" "$backend"
fi
status=$?
set -e
if [ "$status" -ne 0 ]; then
    cat "$test_root/pipewire.log" >&2
    cat "$test_root/wireplumber.log" >&2
    exit "$status"
fi
