#version 450

// Build: glslangValidator -V --target-env vulkan1.1 shader.comp -o shader.spv
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba32f) readonly uniform image2D source_image;
layout(set = 0, binding = 1, rgba32f) uniform image2D destination_image;
layout(push_constant) uniform Parameters {
    uint pixel_mode;
    uint plane_alpha;
    uvec2 crop_origin;
    uvec2 crop_extent;
    uvec2 placement_origin;
    uvec2 destination_origin;
    uvec2 visible_extent;
    uint transform_flags;
    uvec2 placement_extent;
} parameters;

void main() {
    uvec2 invocation = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(invocation, parameters.visible_extent)))
        return;
    uvec2 local = parameters.placement_origin + invocation;
    uvec2 extent = parameters.crop_extent;
    uint rotation = parameters.transform_flags & 3;
    uvec2 transformed_extent = (rotation == 1 || rotation == 3) ? extent.yx : extent;
    local = ((2 * local + 1) * transformed_extent) / (2 * parameters.placement_extent);
    if (rotation == 1)
        local = uvec2(extent.x - 1 - local.y, local.x);
    else if (rotation == 2)
        local = extent - 1 - local;
    else if (rotation == 3)
        local = uvec2(local.y, extent.y - 1 - local.x);
    if ((parameters.transform_flags & 4) != 0)
        local.x = extent.x - 1 - local.x;
    if ((parameters.transform_flags & 8) != 0)
        local.y = extent.y - 1 - local.y;
    ivec2 position = ivec2(parameters.destination_origin + invocation);
    vec4 source = imageLoad(source_image, ivec2(parameters.crop_origin + local));
    vec3 destination = imageLoad(destination_image, position).rgb;
    float plane = float(parameters.plane_alpha) / 65535.0;
    float pixel = parameters.pixel_mode == 0 ? 1.0 : source.a;
    float source_weight = parameters.pixel_mode == 2 ? pixel * plane : plane;
    vec3 color = source.rgb * source_weight + destination * (1.0 - pixel * plane);
    // Keep normalized 16-bit intermediate color, matching the reference's
    // precision policy. Native floating-point arithmetic is qualified with
    // an explicit tolerance, not assumed bit-identical to integer evaluation.
    color = floor(clamp(color, 0.0, 1.0) * 65535.0 + 0.5) / 65535.0;
    imageStore(destination_image, position, vec4(color, 1.0));
}
