<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
  "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "https://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Pronk Project</vendor>
  <vendor_url>https://github.com/pronkproject/pronk</vendor_url>

  <action id="io.github.pronkproject.Pronk.acquire-administrative-grant">
    <description>Create one confined CastKMS administrative grant</description>
    <message>Authentication is required to create a CastKMS administrative grant</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>no</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@libexecdir@/pronk-grant-helper</annotate>
  </action>

  <action id="io.github.pronkproject.Pronk.control-system-service">
    <description>Control the Pronk system service</description>
    <message>Authentication is required to control the Pronk system service</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@bindir@/pronkctl</annotate>
    <annotate key="org.freedesktop.policykit.owner">unix-user:pronk</annotate>
  </action>
</policyconfig>
