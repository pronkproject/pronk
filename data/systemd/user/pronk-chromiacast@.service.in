[Unit]
Description=Pronk Google Cast device backend connection
Requires=pronk-chromiacast.socket
After=pronk-pipewire.service pronk-wireplumber.service
CollectMode=inactive-or-failed

[Service]
Type=notify
ExecStart=@libexecdir@/pronk-chromiacast
Environment=PRONK_BACKEND_INSTANCE=%i
Environment=PRONK_BACKEND_EXPECTED_PEER_UNIT=pronk.service
Environment=PRONK_BACKEND_EXPECTED_PEER_BUS=session
NotifyAccess=main
NonBlocking=yes
FileDescriptorStoreMax=0
Restart=no
TimeoutStartSec=10s
TimeoutStopSec=10s
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
# A deployment enabling hardware encoding must bind and allow its selected
# render node. This base unit intentionally exposes no DRM devices.
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
InaccessiblePaths=-/home -/var/home -/root -%t/pipewire-0 -%t/pronk/media/pipewire-0 -%t/pronk/media/pipewire-0-manager -%t/pronk/media/pipewire-0-pronk-core -%t/pronk/media/pipewire-0-pronk-backend
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
# mdns-sd enumerates interfaces through a read-only NETLINK_ROUTE socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
