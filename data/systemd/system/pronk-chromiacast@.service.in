[Unit]
Description=Pronk system Google Cast device backend connection
# The activation socket is PartOf=pronk.service.  If both it and an accepted
# instance are stopped with pronkd, keep the peer alive until pronkd has sent
# the protocol Shutdown request and observed EOF.
Before=pronk.service
CollectMode=inactive-or-failed

[Service]
Type=notify
User=pronk
Group=pronk
ExecStart=@libexecdir@/pronk-chromiacast
Environment=PRONK_BACKEND_INSTANCE=%i
Environment=PRONK_BACKEND_EXPECTED_PEER_UNIT=pronk.service
Environment=PRONK_BACKEND_EXPECTED_PEER_BUS=system
Environment=HOME=/var/lib/pronk
Environment=XDG_RUNTIME_DIR=/run/pronk
Environment=PIPEWIRE_RUNTIME_DIR=/run/pronk
NotifyAccess=main
NonBlocking=yes
FileDescriptorStoreMax=0
Restart=no
TimeoutStartSec=10s
TimeoutStopSec=10s
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
InaccessiblePaths=-/home -/var/home -/root -/run/pronk/pipewire-0 -/run/pronk/pipewire-0-manager -/run/pronk/pipewire-0-pronk-core -/run/pronk/pipewire-0-pronk-backend
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
# mdns-sd enumerates interfaces through a read-only NETLINK_ROUTE socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
