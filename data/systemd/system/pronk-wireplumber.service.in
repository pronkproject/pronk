[Unit]
Description=Pronk private system media-session manager
BindsTo=pronk-pipewire.socket pronk-pipewire.service
After=pronk-pipewire.socket pronk-pipewire.service
PartOf=pronk.service
Before=pronk.service

[Service]
Type=simple
User=pronk
Group=pronk
ExecStart=@wireplumber@ -p policy
Restart=on-failure
StateDirectory=pronk
StateDirectoryMode=0700
Environment=HOME=/var/lib/pronk
Environment=XDG_RUNTIME_DIR=/run/pronk
Environment=PIPEWIRE_RUNTIME_DIR=/run/pronk
Environment=GIO_USE_VFS=local
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service mincore
SystemCallErrorNumber=EPERM
